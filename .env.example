# SatQuery AI Configuration

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# LLM Provider
LLM_PROVIDER=openai  # openai, deepseek, claude, ollama, gemini
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Alternative: DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Alternative: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Alternative: Google Gemini
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-1.5-pro

# Alternative: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# VLM Provider (Vision Language Model)
VLM_PROVIDER=huggingface  # huggingface, custom_api
VLM_MODEL=google/flan-t5-base  # Will be replaced with proper VLM later

# Data
DATA_DIR=./data/input
OUTPUT_DIR=./data/output
TEMP_DIR=./data/temp

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/satquery.log

# Features
ENABLE_CACHE=true
ENABLE_PROFILING=false
ENABLE_EXECUTION_TRACE=true
